# Port the Express server listens on.
PORT=4000

# MySQL (XAMPP / MariaDB or MySQL Server)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dynamic_form_builder

# JWT signing secret. MUST be set in production.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# Comma-separated emails promoted to the "admin" role at registration.
# Anyone not listed here registers as "user".
ADMIN_EMAILS=admin@example.com

# CORS origin(s) allowed to hit the API (comma-separated). Include both if you
# open the Next app as http://localhost:3000 or http://127.0.0.1:3000.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
